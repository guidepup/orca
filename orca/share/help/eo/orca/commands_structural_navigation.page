        </item>
        <item>
          <p>Komenco kaj fino de la aktuala ujo: <keyseq><key>Shift</key><key>Comma</key></keyseq> kaj <keyseq><key>Comma</key></keyseq></p>
        </item>
      </list>
    </section>
