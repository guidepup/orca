    <section id="lists">
      <title>Listoj</title>
      <list>
        <item>
          <p>Sekva kaj antaŭa listo: <keyseq><key>L</key></keyseq> kaj <keyseq><key>Shift</key><key>L</key></keyseq></p>
        </item> 
        <item>
          <p>Montri liston de listoj: <keyseq><key>Alt</key><key>Shift</key><key>L</key></keyseq></p>
        </item>
        <item>
          <p>Sekva kaj antaŭa lista elemento: <keyseq><key>I</key></keyseq> kaj <keyseq><key>Shift</key><key>I</key></keyseq></p>
        </item> 
        <item>
          <p>Montri liston de listaj elementoj: <keyseq><key>Alt</key><key>Shift</key><key>I</key></keyseq></p>
        </item>
      </list>
    </section>
    <section id="tables">
      <title>Tabeloj</title>
      <list>
        <item>
          <p>Sekva kaj antaŭa tabelo: <keyseq><key>T</key></keyseq> kaj <keyseq><key>Shift</key><key>T</key></keyseq></p>
        </item> 
        <item>
          <p>Montri liston de tabeloj: <keyseq><key>Alt</key><key>Shift</key><key>T</key></keyseq></p>
        </item>
        <item>
          <p>Ĉelo maldekstre: <keyseq><key>Alt</key><key>Shift</key><key>Left</key></keyseq></p>
        </item> 
        <item>
          <p>Ĉelo dekstre: <keyseq><key>Alt</key><key>Shift</key><key>Right</key></keyseq></p>
        </item> 
        <item>
          <p>Ĉelo supre: <keyseq><key>Alt</key><key>Shift</key><key>Up</key></keyseq></p>
        </item> 
        <item>
          <p>Ĉelo sube: <keyseq><key>Alt</key><key>Shift</key><key>Down</key></keyseq></p>
        </item> 
        <item>
          <p>Unua ĉelo en tabelo: <keyseq><key>Alt</key><key>Shift</key><key>Home</key></keyseq></p>
        </item> 
        <item>
          <p>Lasta ĉelo en tabelo: <keyseq><key>Alt</key><key>Shift</key><key>End</key></keyseq></p>
        </item> 
      </list>
    </section>
    <section id="text_blocks">
      <title>Tekstblokoj</title>
      <list>
        <item>
          <p>Sekva kaj antaŭa paragrafo: <keyseq><key>P</key></keyseq> kaj <keyseq><key>Shift</key><key>P</key></keyseq></p>
        </item> 
        <item>
          <p>Montri liston de paragrafoj: <keyseq><key>Alt</key><key>Shift</key><key>P</key></keyseq></p>
        </item>
        <item>
          <p>Sekva kaj antaŭa blokcitaĵo: <keyseq><key>Q</key></keyseq> kaj <keyseq><key>Shift</key><key>Q</key></keyseq></p>
        </item> 
        <item>
          <p>Montri liston de blokcitaĵoj: <keyseq><key>Alt</key><key>Shift</key><key>Q</key></keyseq></p>
        </item>
        <item>
          <p>Sekva kaj antaŭa "granda objekto": <keyseq><key>O</key></keyseq> kaj <keyseq><key>Shift</key><key>O</key></keyseq></p>
        </item> 
        <item>
          <p>Montri liston de "grandaj objektoj": <keyseq><key>Alt</key><key>Shift</key><key>O</key></keyseq></p>
        </item>
       </list>
    </section>
