        </item> 
        <item>
          <p>Zobraziť zoznam tabuliek: <keyseq><key>Alt</key><key>Shift</key><key>T</key></keyseq></p>
        </item>
        <item>
          <p>Bunka vľavo: <keyseq><key>Alt</key><key>Shift</key><key>Vľavo</key></keyseq></p>
        </item> 
        <item>
          <p>Bunka vpravo: <keyseq><key>Alt</key><key>Shift</key><key>Vpravo</key></keyseq></p>
        </item> 
        <item>
