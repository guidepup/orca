    <title type="sort">3. Čavrljanje</title>
    <title type="link">Čavrljanje</title>
    <desc>Podešavanje Orcine podrške za izravno dopisivanje i IRC</desc>
    <credit type="author">
      <name>Joanmarie Diggs</name>
      <email>joanied@gnome.org</email>
    </credit>
